<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pint_surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="88dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/settings_title"
                android:textColor="@color/pint_foreground"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="66dp"
                android:layout_height="89dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/settings_mug_preview"
                android:src="@drawable/pint_full_bubbles" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:text="@string/calories_per_beer"
                android:textColor="@color/pint_foreground"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calories_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/calories_default_value"
                android:textColor="@color/pint_foreground"
                android:textSize="36sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/calories_slider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/calories_per_beer"
                android:progress="14"
                android:progressBackgroundTint="@color/pint_unavailable_foreground"
                android:progressTint="@color/pint_amber"
                android:thumbTint="@color/pint_amber" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calories_minimum"
                    android:textColor="@color/pint_unavailable_foreground"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/calories_maximum"
                    android:textColor="@color/pint_unavailable_foreground"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/decrease_calories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/decrease_calories_accessibility"
                    android:text="@string/decrease_calories"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/reset_calories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.7"
                    android:text="@string/reset_calories"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/increase_calories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/increase_calories_accessibility"
                    android:text="@string/increase_calories"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/calories_explanation"
                android:textColor="@color/pint_unavailable_foreground"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/settings_back_background"
        android:contentDescription="@string/navigate_back"
        android:padding="15dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/pint_foreground" />
</FrameLayout>
